@model Snack;
<div class="col-sm-4 col-md-4 col-lg-4">
    <p><img class="img-fluid" src="@Model.ImageUrl" style="max-width: 200px; height: auto;border-radius:20px" alt="@Model.SnackName" /></p>
    <h3>Price: @Model.SnackPrice.ToString("C")</h3>
    <h4>@Model.SnackName</h4>
    <p>@Model.SnackDescriptionShort</p>

</div>